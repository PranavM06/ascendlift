# Copy to .env for local development. Never commit .env.
ASCENDLIFT_ENVIRONMENT=development
ASCENDLIFT_DATABASE_URL=postgresql+psycopg://ascendlift:ascendlift@localhost:5432/ascendlift

# Signs access tokens; at least 32 characters. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ASCENDLIFT_JWT_SECRET=

# App identifiers Apple identity tokens may be issued for, as a JSON list.
# "host.exp.Exponent" is Expo Go; add the real bundle id for standalone builds.
ASCENDLIFT_APPLE_AUDIENCES=["host.exp.Exponent"]

# For food search, which reads USDA FoodData Central. The demo key works but
# allows only a few dozen searches an hour; get a free key of your own at
# https://fdc.nal.usda.gov/api-key-signup
ASCENDLIFT_USDA_API_KEY=DEMO_KEY
